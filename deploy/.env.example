# PeerDesk — Production Environment Variables
# Copy to .env and fill in your values:
#   cp .env.example .env
#   nano .env

# ── Database ──────────────────────────────────────────────
POSTGRES_USER=peerdesk
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=peerdesk

# ── Auth ──────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_jwt_secret_at_least_32_chars

# Dedicated key for encrypting saved connect-passwords at rest (Fernet). Keep it
# distinct from JWT_SECRET so the two can rotate independently. Generate with:
# openssl rand -hex 32   (if unset, the code falls back to a JWT_SECRET-derived key)
SAVED_PW_KEY=CHANGE_ME_saved_password_key_at_least_32_chars

# ── URLs baked into the React build ──────────────────────
# Replace your-domain.com with your actual domain or server IP.
# For HTTP-only: keep ws:// and http://
# For HTTPS: use wss:// and https://
VITE_SIGNALING_URL=ws://your-domain.com/ws
VITE_API_URL=http://your-domain.com/api

# ── TURN relay (coturn) ───────────────────────────────────
# Generate with: openssl rand -hex 24
TURN_SECRET=CHANGE_ME_turn_secret
# Address clients reach the TURN server at — your domain or server IP.
# Must be reachable by BOTH the viewer and the agent (for external access,
# port-forward UDP 3478 + 49160-49200 to this host).
TURN_HOST=your-domain.com

# ── Agent downloads ───────────────────────────────────────────────────────
# The server mirrors GitHub releases so clients never call the GitHub API
# (which allows only 60 requests/hour per source IP, shared by everyone behind
# your NAT) and so machines with no route to GitHub can still install an agent.
RELEASE_REPO=Ancyent/peerdesk
# How often to check for a new release. Set to 0 for an air-gapped server:
# nothing is fetched and the cache is served exactly as you populated it.
RELEASE_REFRESH_SECONDS=3600
# Optional. Raises the GitHub API limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=
