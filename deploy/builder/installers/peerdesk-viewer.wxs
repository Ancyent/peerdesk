<?xml version="1.0" encoding="utf-8"?>
<!--
  MSI definition for the PeerDesk viewer, built with wixl on Linux.

  We own this because the Tauri CLI will not bundle for Windows from a Linux
  host: its "bundles" flag offers only deb, rpm and appimage there, and its
  "target" flag changes the compile target, not the package formats. wixl
  builds a real MSI natively, with no Wine.

  wixl supports a subset of WiX v3: MediaTemplate is not in it, so Media is
  spelled out, and every Component carries an explicit Guid.

  UpgradeCode must never change between versions - it is what tells Windows
  that v2 replaces v1 rather than installing beside it.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="$(var.ProductName)"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="$(var.ProductName)"
           UpgradeCode="6f1b3c4e-9a2d-4d5e-8b7a-1c2d3e4f5a6b">

    <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" />

    <MajorUpgrade
      AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="A newer version of $(var.ProductName) is already installed." />

    <Media Id="1" Cabinet="peerdesk.cab" EmbedCab="yes" />

    <!--
      WebView2. The viewer is a Tauri app and does not start without the Edge
      WebView2 runtime, which is present on current Windows 11 and usually on
      Windows 10, but absent on a clean or LTSC install.

      This mirrors what the official CI-built installer does, established by
      extracting its tables rather than by reading documentation: three registry
      searches filling one property, then a custom action that downloads
      Microsoft's bootstrapper and runs it silently, only on install, and only
      when nothing was found.

      Win64="yes" produces locator type 18, which is raw (2) plus the 64-bit
      flag (16). Dropping it leaves XML that looks correct and a search that
      reads the wrong registry view. deploy/builder/webview2_check.py asserts it.
    -->
    <Property Id="INSTALLED_WEBVIEW2_VERSION">
      <RegistrySearch Id="Webview2VersionSystemx64" Root="HKLM"
        Key="SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
        Name="pv" Type="raw" Win64="yes" />
      <RegistrySearch Id="Webview2VersionSystemx86" Root="HKLM"
        Key="SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
        Name="pv" Type="raw" Win64="yes" />
      <RegistrySearch Id="Webview2VersionUser" Root="HKCU"
        Key="SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
        Name="pv" Type="raw" Win64="yes" />
    </Property>

    <!--
      Property holds the executable path, ExeCommand holds the argument
      string; that is what lands each in the CustomAction row's Source and
      Target columns respectively, and it is Target the checker inspects for
      the bootstrapper URL and switches.

      wixl's preprocessor treats a bare "$identifier" as a variable reference
      and silently drops the "$" when nothing matches; "$$" is the escape for
      a literal dollar sign. Without doubling, ExeCommand would lose every
      "$" and the PowerShell would reference bareword names instead of
      $ErrorActionPreference / $env:TEMP.
    -->
    <!--
      Bare "powershell.exe", deliberately, not a qualified path: this is
      not an oversight. The Property table's Value column is Text, not
      Formatted (CustomAction's own Target is Formatted; Source is
      CustomSource, a different column with different rules), so a
      "[SystemFolder]..." value here would reach CreateProcess literally,
      brackets and all: not a syntax error, just a path that does not
      exist, which fails this Return="check" action and rolls back the
      install on exactly the WebView2-less machines it exists for. Type 51
      (a SetProperty formatting the value at execution time) is the
      documented way to put a resolved system path into a property, but
      wixl 0.101 rejects <SetProperty> outright.
      A Property-sourced CustomAction does carry residual unqualified-path
      exposure, but msiexec.exe, unlike a downloaded setup.exe, launches
      from System32, so the search order's first hit is already the real
      one; there is no user-writable "wherever setup.exe was double-clicked
      from" step the way there is on the NSIS side. That gap is real but
      materially smaller, and closing it would need a Type 51 SetProperty
      or a COMSPEC-wrapped command wixl cannot build or this environment
      cannot verify.
    -->
    <Property Id="Webview2BootstrapperExe" Value="powershell.exe" />

    <!--
      The TLS 1.2 clause is copied from the reference installer, not invented
      here. On a host whose PowerShell defaults to TLS 1.0 the HTTPS request
      to go.microsoft.com simply fails, and Return="check" turns that into
      "cannot install at all". Windows 10 1803 and later ship .NET 4.7.2 or
      newer, which negotiates TLS 1.2 by default, so the blast radius is
      narrow; it is not zero, and the reference guards it, so we guard it too.

      Two details are deliberate rather than accidental:
      * The brackets and braces are written [\[] [\]] [\{] [\}]. CustomAction's
        Target column is Formatted, so a bare "[Net.ServicePointManager]" would
        be read as a property reference and substituted away to nothing,
        leaving syntactically broken PowerShell. The reference escapes them the
        same way, which is why its exported Target looks like that too.
      * SecurityProtocol is assigned, not OR'd, exactly as the reference does
        it. That narrows the enabled protocol set to TLS 1.2 alone, dropping
        TLS 1.3 where it was enabled, but only inside this one short lived
        PowerShell process, which makes exactly one HTTPS request and exits.
        The parent install is unaffected.
    -->
    <!--
      Impersonate="no" is a deliberate divergence from the reference, which
      runs its action impersonated. This is a perMachine install, so running
      as LocalSystem is what lets the bootstrapper install a machine wide
      runtime without depending on the invoking user's rights. The
      consequence to know: $env:TEMP resolves to the system profile's temp
      directory (typically C:\Windows\Temp) rather than the user's, so that
      is where the downloaded bootstrapper lands and where to look for it
      when diagnosing a failed install. It is also what makes our Type carry
      the 2048 bit that the reference's 1058 does not; see the Type note in
      deploy/builder/webview2_check.py.
    -->
    <CustomAction Id="DownloadAndInvokeBootstrapper" Property="Webview2BootstrapperExe"
      ExeCommand="-NoProfile -WindowStyle Hidden -Command &quot;$$ErrorActionPreference='Stop'; try [\{] [\[]Net.ServicePointManager[\]]::SecurityProtocol = [\[]Net.SecurityProtocolType[\]]::Tls12 [\}] catch [\{][\}]; Invoke-WebRequest -Uri 'https://go.microsoft.com/fwlink/p/?LinkId=2124703' -OutFile \&quot;$$env:TEMP\MicrosoftEdgeWebview2Setup.exe\&quot;; Start-Process -FilePath \&quot;$$env:TEMP\MicrosoftEdgeWebview2Setup.exe\&quot; -ArgumentList '/silent','/install' -Wait&quot;"
      Execute="deferred" Return="check" Impersonate="no" />

    <!--
      Sequence="6599" is literal, not a stand-in for Before="InstallFinalize".
      wixl mis-resolves that Before= to a nondeterministic sequence number
      (observed at both 1402, RemoveExistingProducts+1, and 6401,
      PublishProduct+1, across otherwise-identical builds). 1402 is outside
      the install transaction: a deferred, non-impersonated action scheduled
      there cannot write its script record, and Windows Installer fails it
      with error 2762, which (because Return="check" is set) aborts and
      rolls back the whole install, on exactly the machines missing
      WebView2 that this block exists to fix. The official installer runs
      the same action at 6599, immediately before InstallFinalize (6600) and
      inside the transaction started by InstallInitialize (1500). Do not
      change this back to Before="InstallFinalize".
    -->
    <!--
      RemoveExistingProducts at 1501 is load-bearing on upgrades, and 1501 is
      the number the reference installer uses.

      wixl's default puts it at 1401, before InstallInitialize (1500) and so
      outside the install transaction: the previous version is uninstalled and
      committed before the new one starts. If the WebView2 action then fails
      at 6599, Windows Installer rolls back the new install but has nothing to
      restore the removed one from, and the machine is left with neither
      version. The realistic path is a machine carrying an earlier self hosted
      build (which had no WebView2 machinery, so the app never started) taking
      an upgrade that now checks and cannot reach Microsoft.

      At 1501 the removal happens inside the transaction, so the same failure
      rolls back the removal too and the old version survives.

      MajorUpgrade/@Schedule="afterInstallInitialize" is the documented way to
      express this and wixl does NOT implement it: it warns
      "WixlWixMajorUpgrade has no property named 'Schedule'" on stderr and
      carries on emitting 1401. That warning is not an error and does not fail
      the build, which is exactly how this would go unnoticed. wixl ignores
      AllowSameVersionUpgrades on the same element for the same reason.
      Overriding the standard action's Sequence here does work, verified by
      building and reading the emitted InstallExecuteSequence rather than by
      reading documentation.
    -->
    <InstallExecuteSequence>
      <RemoveExistingProducts Sequence="1501" />
      <Custom Action="DownloadAndInvokeBootstrapper" Sequence="6599">NOT(REMOVE OR INSTALLED_WEBVIEW2_VERSION)</Custom>
    </InstallExecuteSequence>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="$(var.ProductName)">
          <Component Id="MainExecutable" Guid="8a7b6c5d-4e3f-4a2b-9c8d-7e6f5a4b3c2d" Win64="yes">
            <File Id="PeerDeskExe" Name="$(var.BinaryName)"
                  Source="$(var.BinaryName)" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>

      <Directory Id="ProgramMenuFolder">
        <Directory Id="AppMenuFolder" Name="$(var.ProductName)">
          <Component Id="StartMenuShortcut" Guid="2b3c4d5e-6f7a-4b8c-9d0e-1f2a3b4c5d6e">
            <Shortcut Id="AppShortcut" Name="$(var.ProductName)"
                      Target="[INSTALLFOLDER]$(var.BinaryName)"
                      WorkingDirectory="INSTALLFOLDER" />
            <RemoveFolder Id="RemoveAppMenuFolder" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\$(var.ProductName)" Name="installed"
                           Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <Feature Id="Complete" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Product>
</Wix>
